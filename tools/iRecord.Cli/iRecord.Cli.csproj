<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>iRecord-cli</AssemblyName>
    <RootNamespace>iRecord.CliLauncher</RootNamespace>
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <Product>iRecord</Product>
    <AssemblyTitle>iRecord CLI</AssemblyTitle>
    <Company>iRecord</Company>
    <Description>Headless command line interface for iRecord.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\iRecord.csproj" AdditionalProperties="SelfContained=false" />
  </ItemGroup>

</Project>
